# ─────────────────────────────────────────────────────────────
# AI Manager Platform — environment variables
# Copy to .env (root) and / or backend/.env, frontend/.env.local
# ─────────────────────────────────────────────────────────────

# ─── Supabase (DB + Auth + Storage) ───────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                 # public, frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # backend only — DO NOT ship to FE
SUPABASE_JWT_SECRET=                            # for verifying user JWTs in FastAPI
# Direct Postgres DSN for Alembic / SQLAlchemy. Get from Supabase dashboard → Connection String → URI
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres

# ─── LLM providers ────────────────────────────────────────────
# Moonshot (Kimi) — used for task_generation and backlog_optimizer per PRD §9.3
MOONSHOT_API_KEY=sk-...
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Qwen (DashScope) — used for info_discovery + embeddings
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic — optional fallback for quality A/B testing (coaching is V1)
ANTHROPIC_API_KEY=

# ─── Backend runtime ──────────────────────────────────────────
APP_ENV=development                              # development | staging | production
APP_LOG_LEVEL=INFO
BACKEND_PORT=8000
# Per-workspace daily LLM spend ceiling. Hard-stop when exceeded.
DEFAULT_DAILY_LLM_BUDGET_USD=2.00

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
